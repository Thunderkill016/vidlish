{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "functions": {
    "app/.well-known/workflow/**": {
      "maxDuration": 300
    },
    "app/api/**": {
      "maxDuration": 60
    }
  }
}

# Public Supabase settings (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Server-only settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key
AUTH_ADAPTER=supabase

# Video metadata: use fixture locally/CI and youtube in staging/production.
VIDEO_METADATA_ADAPTER=fixture
YOUTUBE_DATA_API_KEY=
YOUTUBE_VIEWER_REGION=VN
YOUTUBE_METADATA_TIMEOUT_MS=5000

# Durable generation. Local/CI use fake + inline; hosted uses Supabase + Vercel Workflow.
GENERATION_REPOSITORY=fake
GENERATION_DISPATCHER=inline
GENERATION_MAX_ACTIVE_JOBS=2
GENERATION_MAX_JOBS_PER_DAY=20
GENERATION_MAX_JOBS_PER_MINUTE=3

# Native-caption fast path. Never send a preferred language; the language gate decides eligibility.
TRANSCRIPT_NATIVE_ENABLED=true
TRANSCRIPT_NATIVE_ADAPTER=fixture
TRANSCRIPT_REPOSITORY=fake
SUPADATA_API_KEY=
SUPADATA_NATIVE_TIMEOUT_MS=8000

# Lesson Engine. Local/CI use the fixture; hosted uses one explicitly selected Gemini model.
# Model capability metadata lives in src/platform/ai/gemini-model-registry.ts;
# production does not automatically rotate/fallback across models.
LESSON_PROVIDER=fixture
LESSON_MODEL_ID=gemini-3.7-flash
GEMINI_API_KEY=

# Reviewed A0 source audio. Gemini TTS is opt-in: it never receives learner text,
# only exact strings in the starter catalogue. Keep it off in local/CI fixtures.
GEMINI_TTS_ENABLED=false
GEMINI_TTS_MODEL_ID=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Which adapter authors the v2 learning blueprint.
#   off     - no v2 lesson is published (production default)
#   gemini  - real authoring, needs GEMINI_API_KEY
#   fixture - a stand-in lesson for dev and CI
# Production refuses `fixture`: a stand-in lesson is indistinguishable from a
# real one once published, so a learner would study a demo believing it came
# from their own video.
LEARNING_AUTHORING_PROVIDER=fixture

# Where v2 sessions, attempts and published blueprints are stored.
#   fake     - in-process, resets with the server (dev/CI)
#   supabase - durable (production default)
LEARNING_SESSION_REPOSITORY=fake

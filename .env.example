# Public Supabase settings (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
NEXT_PUBLIC_AUTH_RESEND_COOLDOWN_SECONDS=60

# Server-only settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key
AUTH_ADAPTER=supabase

# Deterministic local/E2E authentication adapter only.
AUTH_FAKE_CODE=123456
TEST_BETA_EMAILS=invited@example.com

# Video metadata: use fixture locally/CI and youtube in staging/production.
VIDEO_METADATA_ADAPTER=fixture
YOUTUBE_DATA_API_KEY=
YOUTUBE_VIEWER_REGION=VN
YOUTUBE_METADATA_TIMEOUT_MS=5000

# Durable generation. Local/CI may use fake + inline; hosted environments use Supabase + Inngest.
GENERATION_REPOSITORY=fake
GENERATION_DISPATCHER=inline
GENERATION_MAX_ACTIVE_JOBS=2
GENERATION_MAX_JOBS_PER_DAY=20
GENERATION_MAX_JOBS_PER_MINUTE=3

# Native captions remain the zero-cost first strategy.
TRANSCRIPT_NATIVE_ENABLED=true
TRANSCRIPT_NATIVE_ADAPTER=fixture
TRANSCRIPT_REPOSITORY=fake
SUPADATA_API_KEY=
SUPADATA_NATIVE_TIMEOUT_MS=8000

# Hosted generated transcript fallback. Never send a preferred language.
TRANSCRIPT_GENERATED_ENABLED=true
TRANSCRIPT_GENERATED_ADAPTER=fixture
SUPADATA_GENERATED_TIMEOUT_MS=10000
SUPADATA_GENERATED_POLL_INTERVAL_MS=2000
SUPADATA_GENERATED_MAX_POLLS=30
TRANSCRIPT_GENERATED_MAX_VIDEO_DURATION_MS=3600000

INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

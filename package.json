{
  "name": "nep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Vietnamese-first English learning practice that compounds from zero into real use.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "audio:curriculum": "node scripts/build-curriculum-audio.mjs",
    "curriculum": "node scripts/check-curriculum.mjs",
    "copy": "node scripts/checks/learner-copy-readable.mjs",
    "db:local": "node scripts/local-schema.mjs",
    "study:golden": "node --import=./scripts/golden-study-preload.mjs scripts/golden-study-harness.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "franc-min": "6.2.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "ts-fsrs": "^5.4.1",
    "workflow": "4.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.0.0",
    "kokoro-js": "^1.2.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
